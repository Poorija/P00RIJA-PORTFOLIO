# P00RIJA Portfolio — environment template.
# Copy to `.env` and adjust. Every value here is OPTIONAL when running the
# Docker image: on first boot the container generates a session secret and,
# if no admin password is set, falls back to the documented default (admin123)
# while writing a CMS-PASSWORD.txt warning file next to the database.

# HMAC secret for CMS sessions. Leave empty in Docker mode (auto-generated
# and kept for the lifetime of the container). For native (non-Docker) installs
# generate one:  openssl rand -hex 32
AUTH_SECRET=

# CMS admin password. ⚠ DEFAULT — change it immediately after first login
# (CMS → Settings → change password), or set a strong value here before boot.
ADMIN_PASSWORD=admin123

# SQLite location inside the container. Do not change unless you know why.
DATABASE_URL=file:/app/db/custom.db

# Commercial licensing (leave BOTH unset to run unlocked — dev/public builds).
# LICENSE_AES_KEY=            # 64 hex chars — provided by the vendor
# LICENSE_SIGN_PUBKEY=        # 64 hex chars — provided by the vendor
# License URLs inside license files pointing at private/internal
# addresses are rejected as SSRF protection. Only set this if your
# licensing endpoint really runs on a LAN/private address:
# LICENSE_ALLOW_PRIVATE_SERVERS=1
# LICENSE_HEARTBEAT_MINUTES=10 # check-in cadence override
# LICENSE_GRACE_CHECKS=2      # failed checks before maintenance lock

# Optional overrides (the installer writes these automatically):
# PORT=3000
# P00RIJA_CPUS=0.7
# P00RIJA_MEMORY_LIMIT=512m

# Optional SMTP password for the contact-form `smtp` delivery provider
# (referenced from CMS → Forms → Delivery as `passwordEnv`).
# SMTP_PASS=
